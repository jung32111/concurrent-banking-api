# docker-compose 환경변수 템플릿
# 실제 사용 시 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 처리되어 커밋되지 않습니다.

# JWT 서명용 비밀키 — 최소 256bit(32자) 이상의 랜덤 문자열 사용
# 생성 예시:  openssl rand -base64 48
JWT_SECRET=

# 앱 → DB 연결
DB_URL=jdbc:mysql://localhost:3306/concurrent_banking?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MySQL 컨테이너 초기화
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=concurrent_banking
MYSQL_USER=
MYSQL_PASSWORD=
