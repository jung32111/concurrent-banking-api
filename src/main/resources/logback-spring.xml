<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Spring Boot 기본 설정 포함 (색상, 레벨 등) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
        로그 패턴: %X{traceId} 를 통해 MDC에 저장된 traceId를 모든 로그에 자동 출력.
        TraceId가 없는 경우(애플리케이션 초기화 로그 등)는 빈 문자열로 처리.
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36}%X{traceId:+[ traceId=%X{traceId}]} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Hibernate SQL 로그 (기존 application.yml 설정과 동일) -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
